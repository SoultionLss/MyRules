{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "block"
    },
    {
      "type": "shadowsocks",
      "tag": "node1",
      "server": "your-server.example.com",
      "server_port": 8388,
      "method": "aes-256-gcm",
      "password": "your-password"
    },
    {
      "type": "selector",
      "tag": "global",
      "outbounds": [
        "node1",
        "direct"
      ]
    },
    {
      "type": "selector",
      "tag": "streaming",
      "outbounds": [
        "node1",
        "direct"
      ]
    },
    {
      "type": "selector",
      "tag": "google",
      "outbounds": [
        "node1",
        "direct"
      ]
    },
    {
      "type": "selector",
      "tag": "ai",
      "outbounds": [
        "node1",
        "direct"
      ]
    },
    {
      "type": "selector",
      "tag": "social",
      "outbounds": [
        "node1",
        "direct"
      ]
    },
    {
      "type": "selector",
      "tag": "telegram",
      "outbounds": [
        "node1",
        "direct"
      ]
    },
    {
      "type": "selector",
      "tag": "spotify",
      "outbounds": [
        "node1",
        "direct"
      ]
    },
    {
      "type": "selector",
      "tag": "game",
      "outbounds": [
        "node1",
        "direct"
      ]
    },
    {
      "type": "selector",
      "tag": "emby",
      "outbounds": [
        "node1",
        "direct"
      ]
    },
    {
      "type": "selector",
      "tag": "final",
      "outbounds": [
        "node1",
        "direct"
      ]
    }
  ],
  "route": {
    "rule_set": [
    {"type": "remote", "tag": "Direct", "url": "https://github.com/SoultionLss/MyRules/raw/main/sing-box/Rules/Direct.json", "download_detour": "auto"},
    {"type": "remote", "tag": "Reject", "url": "https://github.com/SoultionLss/MyRules/raw/main/sing-box/Rules/Reject.json", "download_detour": "auto"},
    {"type": "remote", "tag": "Netflix", "url": "https://github.com/SoultionLss/MyRules/raw/main/sing-box/Rules/Netflix.json", "download_detour": "auto"},
    {"type": "remote", "tag": "Disney", "url": "https://github.com/SoultionLss/MyRules/raw/main/sing-box/Rules/Disney.json", "download_detour": "auto"},
    {"type": "remote", "tag": "HBO", "url": "https://github.com/SoultionLss/MyRules/raw/main/sing-box/Rules/HBO.json", "download_detour": "auto"},
    {"type": "remote", "tag": "AppleTV", "url": "https://github.com/SoultionLss/MyRules/raw/main/sing-box/Rules/AppleTV.json", "download_detour": "auto"},
    {"type": "remote", "tag": "Hulu", "url": "https://github.com/SoultionLss/MyRules/raw/main/sing-box/Rules/Hulu.json", "download_detour": "auto"},
