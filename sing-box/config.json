{
  "log": {
    "level": "info"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "block"
    },
    {
      "type": "shadowsocks",
      "tag": "node1",
      "server": "your-server.example.com",
      "server_port": 8388,
      "method": "aes-256-gcm",
      "password": "your-password"
    },
    {
      "type": "selector",
      "tag": "global",
      "outbounds": [
        "node1",
        "direct"
      ]
    },
    {
      "type": "selector",
      "tag": "streaming",
      "outbounds": [
        "node1",
        "direct"
      ]
    },
    {
      "type": "selector",
      "tag": "google",
      "outbounds": [
        "node1",
        "direct"
      ]
    },
    {
      "type": "selector",
      "tag": "ai",
      "outbounds": [
        "node1",
        "direct"
      ]
    },
    {
      "type": "selector",
      "tag": "social",
      "outbounds": [
        "node1",
        "direct"
      ]
    },
    {
      "type": "selector",
      "tag": "telegram",
      "outbounds": [
        "node1",
        "direct"
      ]
    },
    {
      "type": "selector",
      "tag": "spotify",
      "outbounds": [
        "node1",
        "direct"
      ]
    },
    {
      "type": "selector",
      "tag": "game",
      "outbounds": [
        "node1",
        "direct"
      ]
    },
    {
      "type": "selector",
      "tag": "emby",
      "outbounds": [
        "node1",
        "direct"
      ]
    },
    {
      "type": "selector",
      "tag": "final",
      "outbounds": [
        "node1",
        "direct"
      ]
    }
  ],
  "route": {
    "rule_set": [
    {"type": "remote", "tag": "Netflix", "url": "https://github.com/用户名/仓库名/raw/main/sing-box/Rules/Netflix.json", "download_detour": "auto"},
    {"type": "remote", "tag": "Telegram", "url": "https://github.com/用户名/仓库名/raw/main/sing-box/Rules/Telegram.json", "download_detour": "auto"},
    {"type": "remote", "tag": "AI", "url": "https://github.com/用户名/仓库名/raw/main/sing-box/Rules/AI.json", "download_detour": "auto"}
  ],
    "rules": [
    {"action": "route", "rule_set": ["Netflix"], "outbound": "Streaming"},
    {"action": "route", "rule_set": ["Telegram"], "outbound": "Telegram"},
    {"action": "route", "rule_set": ["AI"], "outbound": "AI"},
    {"action": "route", "geoip": ["cn"], "outbound": "direct"},
    {"action": "route", "ip_is_private": true, "outbound": "direct"},
    {"action": "route", "outbound": "final"}
  ]
  }
}
