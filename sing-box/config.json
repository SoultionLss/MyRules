    {"type": "remote", "tag": "Messaging", "url": "https://github.com/SoultionLss/MyRules/raw/main/sing-box/Rules/Messaging.json", "download_detour": "auto"},
    {"type": "remote", "tag": "Telegram", "url": "https://github.com/SoultionLss/MyRules/raw/main/sing-box/Rules/Telegram.json", "download_detour": "auto"},
    {"type": "remote", "tag": "YouTube", "url": "https://github.com/SoultionLss/MyRules/raw/main/sing-box/Rules/YouTube.json", "download_detour": "auto"},
    {"type": "remote", "tag": "Google", "url": "https://github.com/SoultionLss/MyRules/raw/main/sing-box/Rules/Google.json", "download_detour": "auto"},
    {"type": "remote", "tag": "AI", "url": "https://github.com/SoultionLss/MyRules/raw/main/sing-box/Rules/AI.json", "download_detour": "auto"},
    {"type": "remote", "tag": "AICN", "url": "https://github.com/SoultionLss/MyRules/raw/main/sing-box/Rules/AICN.json", "download_detour": "auto"}
  ],
    "rules": [
    {"action": "route", "rule_set": ["Direct"], "outbound": "DIRECT"},
    {"action": "route", "rule_set": ["Reject"], "outbound": "REJECT"},
    {"action": "route", "rule_set": ["Netflix"], "outbound": "Streaming"},
    {"action": "route", "rule_set": ["Disney"], "outbound": "Streaming"},
    {"action": "route", "rule_set": ["HBO"], "outbound": "Streaming"},
    {"action": "route", "rule_set": ["AppleTV"], "outbound": "Streaming"},
    {"action": "route", "rule_set": ["Hulu"], "outbound": "Streaming"},
    {"action": "route", "rule_set": ["PrimeVideo"], "outbound": "Streaming"},
    {"action": "route", "rule_set": ["Spotify"], "outbound": "Spotify"},
    {"action": "route", "rule_set": ["Social"], "outbound": "Social"},
    {"action": "route", "rule_set": ["Messaging"], "outbound": "Global"},
    {"action": "route", "rule_set": ["Telegram"], "outbound": "Telegram"},
    {"action": "route", "rule_set": ["YouTube"], "outbound": "Global"},
    {"action": "route", "rule_set": ["Google"], "outbound": "Google"},
    {"action": "route", "rule_set": ["AI"], "outbound": "AI"},
    {"action": "route", "rule_set": ["AICN"], "outbound": "AI"},
    {"action": "route", "geoip": ["cn"], "outbound": "direct"},
    {"action": "route", "ip_is_private": true, "outbound": "direct"},
    {"action": "route", "outbound": "final"}
  ]
  }
}
